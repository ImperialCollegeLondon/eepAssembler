<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- net8.0 is the oldest .NET still in support, so every current SDK (8, 9, 10, ...)
         can build this project. RollForward lets the built program run on whatever
         runtime is actually installed, so a machine with only a newer .NET runs it
         without .NET 8 being installed. Between them these two lines mean nobody has
         to install a particular .NET version to use the assembler. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>

    <WarnOn>3390;$(WarnOn)</WarnOn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/EEExtensions.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>
</Project>
